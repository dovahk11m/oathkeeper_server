<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Oathkeeper</title>

    <!-- Google Font -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <!-- AdminLTE -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">

    <!-- iCheck Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/icheck-bootstrap@3.0.1/icheck-bootstrap.min.css">

    <link
            href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
            rel="stylesheet"
    >



    <style>
        body { font-family: 'Source Sans Pro', sans-serif; }
        .chat-rooms { max-height: 70vh; overflow-y: auto; }
        .direct-chat-messages { max-height: 60vh; overflow-y: auto; }

.icheck-success label::before {
  transform: scale(0.8);
  transform-origin: center;
}
.icheck-danger label::before {
  transform: scale(0.8);
  transform-origin: center;
}

.table td, .table th {
    vertical-align: middle !important;
}
        .pagination {
    display: flex;
    gap: 10px; /* 글자 사이 간격 */
}



    </style>
    </style>
</head>
<body class="hold-transition sidebar-mini">
<div class="wrapper">
    <!-- Navbar -->
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <!-- Left navbar links -->
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
            </li>
            <li class="nav-item d-none d-sm-inline-block">
                <a href="#" class="nav-link">홈</a>
            </li>
        </ul>

        <!-- Right navbar links -->
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                    <i class="fas fa-expand-arrows-alt"></i>
                </a>
            </li>
        </ul>
    </nav>
    <!-- /.navbar -->

    <!-- Main Sidebar Container -->
    <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <!-- Brand Logo -->
        <a href="#" class="brand-link">
            <span class="brand-text font-weight-light">Oathkeeper</span>
        </a>

        <!-- Sidebar -->
        <div class="sidebar">
            <!-- Sidebar user panel (optional) -->
            <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                <div class="info">
                    <a href="#" class="d-block">관리자</a>
                </div>
            </div>

            <!-- Sidebar Menu -->
            <nav class="mt-2">
                <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">
                    <li class="nav-item">
                        <a href="#" class="nav-link active">
                            <i class="nav-icon fas fa-comments"></i>
                            <p>회원관리</p>
                        </a>
                    </li>
                </ul>
            </nav>
            <!-- /.sidebar-menu -->
        </div>
        <!-- /.sidebar -->
    </aside>

    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <!-- Content Header (Page header) -->
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0">회원관리 대시보드</h1>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main content -->
        <section class="content">
            <div class="container-fluid">
                <div class="row">
                    <!-- 좌측: 방 목록 -->


                    <!-- 우측: 채팅 영역 -->
                    <div class="col-md-10">
                        <div class="card card-outline card-primary">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h3 class="card-title">회원 관리</h3>
                                <div class="card-tools">
                                    <div class="input-group input-group-sm" style="width: 200px;">
                                        <input type="text" name="table_search" class="form-control float-right" placeholder="검색">
                                        <div class="input-group-append">
                                            <button type="submit" class="btn btn-default">
                                                <i class="fas fa-search"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card-body table-responsive p-0">
                                <table class="table table-hover text-center mb-0">
                                    <thead class="table-primary">
                                    <tr>

                                        <th>ID</th>
                                        <th>이름</th>
                                        <th>이메일</th>
                                        <th>권한</th>
                                        <th>권한 선택</th>
                                        <th>소셜 타입</th>
                                        <th>상태</th>
                                        <th>소셜 아이디</th>
                                        <th>마지막 로그인 날짜</th>
                                        <th>금지 만료 기간</th>
                                        <th>금지 기간 설정</th>

                                    </tr>
                                    </thead>
                                    <tbody>
                                    {{#members}}
                                        <tr>
                                            <td>{{id}}</td>
                                            <td>{{username}}</td>
                                            <td>{{email}}</td>
                                            <td>
                                                {{#isAdmin}}
                                                    <span class="badge bg-danger">관리자</span>
                                                {{/isAdmin}}
                                                {{^isAdmin}}
                                                    <span class="badge bg-success">회원</span>
                                                {{/isAdmin}}
                                            </td>
                                            <td>
                                                <form action="//localhost:8080/api/admin/update-role" method="post" class="d-flex">
                                                    <input type="hidden" name="id" value="{{id}}">
                                                    <input type="hidden" name="page" value="{{currentPage}}">

                                                    <div class="d-flex align-items-center justify-content-center flex-row">
                                                        <div class="icheck-success d-inline ml-3">
                                                            <input type="radio" id="radioSuccess-{{id}}" name="role" value="USER">
                                                            <label for="radioSuccess-{{id}}" >회원</label>
                                                        </div>
                                                        <div class="icheck-danger d-inline ml-3">
                                                            <input type="radio" id="radioDanger-{{id}}" name="role" value="ADMIN">
                                                            <label for="radioDanger-{{id}}">관리자</label>
                                                        </div>
                                                    </div>

                                                    <button class="btn btn-primary ml-3 btn-sm" type="submit"><i class="fa-solid fa-check"></i></button>
                                                </form>
                                            </td>
                                            <td>{{socialType}}</td>
                                            <td>{{status}}</td>
                                            <td>{{socialId}}</td>
                                            <td>{{lastLogin}}</td>
                                            <td>{{bannedUntil}}</td>
                                            <td>
                                                <form action="//localhost:8080/api/admin/ban-member" method="post" class="d-flex" style="align-items:center;">
                                                    <input type="hidden" name="id" value="{{id}}">
                                                    <input type="hidden" name="page" value="{{currentPage}}">
                                                    <input type="text" name="days" class="mr-2" style="width:70px; padding:5px;" placeholder="일자">
                                                    <button class="btn btn-primary btn-sm" type="submit"><i class="fa-solid fa-check"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    {{/members}}
                                    </tbody>
                                </table>
                            </div>

                            <div class="card-footer d-flex justify-content-center">
                                <ul class="pagination pagination-sm m-0">
                                    {{#pages}}
                                        {{#isCurrent}}
                                            <li class="page-item active">
                                                <span class="page-link">{{number}}</span>
                                            </li>
                                        {{/isCurrent}}
                                        {{^isCurrent}}
                                            <li class="page-item">
                                                <a class="page-link" href="/api/admin/members?page={{pageIndex}}">{{number}}</a>
                                            </li>
                                        {{/isCurrent}}
                                    {{/pages}}
                                </ul>
                            </div>


                            </div>
                        </div>
                    </div>


                </div>
            </div>
        </section>
    </div>

    <!-- Control Sidebar (optional) -->
    <aside class="control-sidebar control-sidebar-dark">
    </aside>
    <!-- /.control-sidebar -->
</div>

<!-- REQUIRED SCRIPTS -->
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<!-- AdminLTE App -->
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>


<script>

</script>
</body>
</html>
