{{> layout/header}}
<link rel="stylesheet" href="/css/groupList.css">

<div class="wrapper" style="width:100%; margin:30px auto;">
    <h2 style="margin-bottom:20px; color:#333;">채팅 그룹 관리</h2>

    <!-- 상단 컨트롤 (총 그룹 수 + 검색) -->
    <div id="top-controls" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
        <!-- 총 그룹 수 -->
        <div id="group-count">
            총 그룹: {{groups.length}}
        </div>

        <!-- 검색창 + 버튼 -->
        <div id="search-container" style="display:flex; gap:5px;">
            <input type="text" id="searchInput" placeholder="참여자 검색">
            <button id="searchBtn">검색</button>
        </div>
    </div>

    <!-- 그룹 리스트 -->
    <ul id="chat-group-list" class="chat-list">
        {{#groups}}
        <li class="chat-item" data-participants="{{participants}}">
            <div class="group-info">
                <p class="chat-title">[{{id}}] {{name}}</p>
                <p class="chat-members">참여자 수: {{members}}</p>
            </div>
            <div class="chat-time">{{lastMessage}}</div>
        </li>
        {{/groups}}
    </ul>

    <!-- 페이징 -->
    <div class="pagination">
        {{#pages}}
            {{#isCurrent}}
                <button class="page-btn" disabled>{{number}}</button>
            {{/isCurrent}}
            {{^isCurrent}}
                <a href="/admin/group-list?page={{pageIndex}}">
                    <button class="page-btn">{{number}}</button>
                </a>
            {{/isCurrent}}
        {{/pages}}
    </div>
</div>

<script>
const searchInput = document.getElementById("searchInput");
const searchBtn = document.getElementById("searchBtn");
const list = document.getElementById("chat-group-list");
const originalItems = Array.from(list.querySelectorAll("li"));

// 검색 함수
function filterList() {
    const keyword = searchInput.value.toLowerCase();
    list.innerHTML = "";

    const filtered = originalItems.filter(item => {
        const participants = item.dataset.participants.toLowerCase();
        return participants.includes(keyword);
    });

    filtered.forEach(i => list.appendChild(i));
}

// 입력 중에도 필터링
searchInput.addEventListener("input", filterList);

// 검색 버튼 클릭 시 필터링
searchBtn.addEventListener("click", filterList);
</script>
