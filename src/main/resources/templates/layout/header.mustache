<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Oathkeeper Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    html, body {
      height: 100%;
      margin: 0;
      background: #f7f7f7;
      font-family: Inter, system-ui;
    }

body {
  display: flex;
  flex-direction: column;
}

.page-wrapper {
  display: flex;
  gap: 20px;
  max-width: 1400px;
  width: 95%;
  margin: 20px auto;
  padding: 25px;

  background: white;
  border-radius: 16px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.08);

  /* flex 높이 유지 */
  min-height: calc(100vh - 40px);
  box-sizing: border-box; /* padding 포함 높이 계산 */
}

    /* Sidebar */
.sidebar {
  width: 230px;
  background: #ffffff;
  box-shadow: 3px 0 15px rgba(0,0,0,0.06);
  padding: 20px;
  border-radius: 12px;

  /* 이것만 남기기 — 높이는 자동으로 parent에 맞춰짐 */
  height: auto;
}


    .sidebar .menu-title { font-size: 0.8rem; color:#999; margin-top:20px; margin-bottom:10px; }
    .sidebar a {
      display:block; padding:10px 14px; margin-bottom:6px;
      border-radius:10px; text-decoration:none; color:#444;
    }
    .sidebar a:hover { background:#f3e8ff; color:#7c3aed; }

    /* Main content */
    .main-content {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    /* Top Navbar */
    .topnav {
      background:#001f3f; padding:15px 20px;
      display:flex; justify-content:space-between; align-items:center;
      color:#fff;
      border-radius: 12px;
    }

    .logout-btn {
      background: #001f3f;
      color: white;
      border: 1px solid #ffffff;
      padding: 5px 12px;
      border-radius: 6px;
      font-size: 0.8rem;
      cursor: pointer;
      transition: all 0.25s ease-in-out;
    }

    .logout-btn:hover {
      background: #ffffff;
      color: #001f3f;
    }

    /* Main content body (아래 내용) */
    .content-body {
      margin-top: 20px;
      flex: 1; /* 남은 공간 차지 */
      overflow: auto;
    }

  </style>
</head>
<body>
<div class="page-wrapper">

  <!-- Sidebar -->
  <div class="sidebar">
    <h3 class="fw-bold">Admin Dashboard</h3>

    <div class="menu-title">MAIN</div>
    <a href="/admin/dashboard"><i class="fa-solid fa-chart-line me-2"></i> 통계페이지</a>
    <a href="/admin/members"><i class="fa-solid fa-user-group me-2"></i> 회원 관리</a>
    <a href="/admin/groups"><i class="fa-solid fa-comments me-2"></i> 채팅 관리</a>
    <a href="/admin/spots"><i class="fa-solid fa-location-dot me-2"></i> 장소 관리</a>
    <a href="/admin/labels"><i class="fa-solid fa-tag me-2"></i> 태그 관리</a>
    <a href="/admin/spots/labels"><i class="fa-solid fa-tags me-2"></i> 장소-태그 관리</a>
  </div>

  <!-- Main content -->
  <div class="main-content">
    <!-- Top Navbar -->
    <div class="topnav">
      <div class="fw-semibold fs-5">Dashboard Overview</div>
      <div class="d-flex align-items-center">
          <div class="fw-light fs-6 me-2">어서오세요, {{adminName}}님. 관리자 대시보드입니다.</div>

        <form action="/admin/logout" method="POST">
          <button class="logout-btn">로그아웃</button>
        </form>
      </div>
    </div>