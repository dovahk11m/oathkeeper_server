<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard with Sidebar & Charts</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    body { background:#edf1f7; font-family:Inter, system-ui; }

    /* Sidebar */
    .sidebar {
      width: 230px;
      background: #ffffff;
      min-height: 100vh;
      box-shadow: 3px 0 15px rgba(0,0,0,0.06);
      padding: 20px;
    }
    .sidebar .menu-title { font-size: 0.8rem; color:#999; margin-top:20px; margin-bottom:10px; }
    .sidebar a {
      display:block; padding:10px 14px; margin-bottom:6px;
      border-radius:10px; text-decoration:none; color:#444;
    }
    .sidebar a:hover { background:#f3e8ff; color:#7c3aed; }

    /* Top Navbar */
    .main-content { flex: 1; }
    .topnav {
      background:#7c3aed; padding:15px 20px;
      display:flex; justify-content:space-between; align-items:center;
      color:#fff;
    }

    .page-wrapper {
      background: white;
      padding: 25px;
      margin: 20px auto;
      width: 95%;
      max-width: 1400px;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.08);
      display: flex;
      gap: 20px;
    }



  </style>
</head>
<body>
<div class="page-wrapper">

  <!-- Sidebar -->
  <div class="sidebar">
    <h3 class="fw-bold">My Dashboard</h3>

    <div class="menu-title">MAIN</div>
    <a href="#"><i class="fa-solid fa-table-columns me-2"></i> Overview</a>
    <a href="#"><i class="fa-solid fa-user-group me-2"></i> Audience</a>
    <a href="#"><i class="fa-solid fa-chart-line me-2"></i> Engagement</a>
    <a href="#"><i class="fa-solid fa-gear me-2"></i> Settings</a>
  </div>

  <!-- Main content -->
  <div class="main-content">
    <!-- Top Navbar -->
    <div class="topnav">
      <div class="fw-semibold fs-5">Dashboard Overview</div>
      <div class="d-flex align-items-center">
        <input class="form-control form-control-sm me-2" style="width:220px" placeholder="Search...">
        <i class="fa-regular fa-user-circle fa-2x"></i>
      </div>
    </div>