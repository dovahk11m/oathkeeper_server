<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>인기 태그 목록 (관리자)</title>
</head>
<body>
<h2>인기 태그 목록</h2>
<table id="memberTable" border="1">
    <thead>
    <tr>
        <th>태그ID</th>
        <th>태그이름</th>
        <th>참여자수</th>
        <th>플랜수</th>

    </tr>
    </thead>
    <tbody>
    {{#members}}
    <tr>
        <td>{{tagId}}</td>
        <td>{{tagName}}</td>
        <td>{{participantCount}}</td>
        <td>{{planCount}}</td>
    </tr>
    {{/members}}
    </tbody>
</table>

</body>
</html>
