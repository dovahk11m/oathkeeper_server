{{> layout/header}}
<style>
    /* Cards */
    .top-card { border-radius:14px; box-shadow:0 6px 18px rgba(36,59,85,0.06); }
    .small-box { padding:18px; border-radius:12px; }
    .small-box .value { font-size:1.6rem; font-weight:700; }
    .small-box .label { font-size:0.95rem; color:#6b7280; }
    .icon-circle { width:48px; height: 48px; display:flex; align-items:center; justify-content:center; border-radius:12px; }
    .card-custom { border-radius:14px; box-shadow:0 8px 24px rgba(36,59,85,0.06); }

    .bg-p1 { background: linear-gradient(135deg,#e9d5ff,#f3e8ff); }
    .bg-p2 { background: linear-gradient(135deg,#dbeafe,#e0f2fe); }
    .bg-p3 { background: linear-gradient(135deg,#fef3c7,#fff7ed); }
    .bg-p4 { background: linear-gradient(135deg,#fde68a,#fff7ed); }


  </style>


  <div class="container mt-4">

    <!-- Top 4 small boxes -->
    <div class="row g-3">
      <div class="col-12 col-sm-6 col-md-3">
        <div class="small-box bg-p1 top-card d-flex justify-content-between align-items-center">
          <div>
            <div class="label">회원수</div>
            <div class="value">{{member}}</div>

          </div>
          <div class="icon-circle bg-white"><i class="fa-solid fa-users fa-lg" style="color:#7c3aed"></i></div>
        </div>
      </div>
      <div class="col-12 col-sm-6 col-md-3">
        <div class="small-box bg-p2 top-card d-flex justify-content-between align-items-center">
          <div>
            <div class="label">플랜수</div>
            <div class="value">{{plan}}</div>

          </div>
          <div class="icon-circle bg-white"><i class="fa-solid fa-heart fa-lg" style="color:#ef4444"></i></div>
        </div>
      </div>
      <div class="col-12 col-sm-6 col-md-3">
        <div class="small-box bg-p3 top-card d-flex justify-content-between align-items-center">
          <div>
            <div class="label">그룹수</div>
            <div class="value">{{group}}</div>

          </div>
          <div class="icon-circle bg-white"><i class="fa-solid fa-comments fa-lg" style="color:#059669"></i></div>
        </div>
      </div>
      <div class="col-12 col-sm-6 col-md-3">
        <div class="small-box bg-p4 top-card d-flex justify-content-between align-items-center">
          <div>
            <div class="label">채팅수</div>
            <div class="value">{{chat}}</div>

          </div>
          <div class="icon-circle bg-white"><i class="fa-solid fa-file-image fa-lg" style="color:#f97316"></i></div>
        </div>
      </div>
    </div>

    <!-- Bottom 3 boxes with charts -->
    <div class="row g-3 mt-3">

      <div class="col-12 col-md-4">
        <div class="card card-custom p-3 h-100">
          <h6 class="mb-2">누적 참여자 수</h6>
          <canvas id="chartFollowers" height="300"></canvas>
        </div>
      </div>

      <div class="col-12 col-md-4">
        <div class="card card-custom p-3 h-100">
          <h6 class="mb-2">누적 플랜 수</h6>
          <canvas id="chartLikes" height="300"></canvas>
        </div>
      </div>

      <div class="col-12 col-md-4">
        <div class="card card-custom p-3 h-100">
          <h6 class="mb-2">태그 비중</h6>
          <canvas id="chartTags" height="130"></canvas>
        </div>
      </div>

    </div>
  </div>
</div>
</div>

<script>
    // Followers Chart
    fetch('/api/admin/par-count')
      .then(res => res.json())
      .then(json => {

        const labels = json.map(item => item.monthweek);
        const count = json.map(item => item.count);

        new Chart(document.getElementById('chartFollowers'), {
          type: 'line',
          data: {
            labels: labels,
            datasets: [{
              data: count,
              borderWidth: 2,
              tension: 0.4
            }]
          },
          options: { plugins:{legend:{display:false}}, scales:{y:{beginAtZero:true}} }
        });
      });

    // Likes Chart
    fetch('/api/admin/plan-count')
      .then(res => res.json())
      .then(json => {

        const labels = json.map(item => item.monthweek);
        const partcount = json.map(item => item.count);

        new Chart(document.getElementById('chartLikes'), {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [{ data: partcount }]
          },
          options: { plugins:{legend:{display:false}}, scales:{y:{beginAtZero:true}} }
        });
      });

    // Tags Chart
    fetch('/api/admin/plan-tag-pie')
      .then(res => res.json())
      .then(json => {

        const labels = json.map(item => item.tagName);
        const count = json.map(item => item.planCount);

        new Chart(document.getElementById('chartTags'), {
          type: 'pie',
          data: {
            labels: labels,
            datasets: [{ data: count}]
          }
        });
      });
</script>


</body>
</html>
